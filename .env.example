# MAJUBAH — variables d'environnement (à définir dans le dashboard de l'hébergeur).
# Ne committez JAMAIS le vrai .env. Ce fichier ne contient aucun secret.

# --- Réservation → CRM (api/reservation.js) ---
# URL du webhook CRM qui reçoit les leads. Sans cette variable, le formulaire
# renvoie une erreur explicite (aucun faux succès).
CRM_WEBHOOK_URL=

# (Optionnel) en-tête d'authentification du webhook CRM.
# Format "Nom: valeur" (ex. "x-api-key: xxxxx") ou directement un token Bearer.
CRM_AUTH_HEADER=

# --- Newsletter (api/newsletter.js) — choisir UN des deux modes ---
# Mode 1 : Brevo (priorité si BREVO_API_KEY est défini)
BREVO_API_KEY=
BREVO_LIST_ID=
# Double opt-in (recommandé RGPD) : créer un modèle DOI dans Brevo et renseigner :
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=
# Mode 2 : webhook générique (Systeme.io / Zapier / Make / n8n…)
NEWSLETTER_WEBHOOK_URL=

# --- Démo IA (api/ai.js) — uniquement si vous conservez la démo Claude ---
# Clé API Anthropic, côté serveur uniquement.
ANTHROPIC_API_KEY=
